#!/bin/bash

# omarchy-menu-input for the actions the Tusche Bar's drop-down logo menu
# runs (DropMenu.qml puts this directory first on their PATH). Same
# arguments and answer as Omarchy's own command, and the same file protocol:
# the payload goes to the drop-down (`omarchy-shell tusche-bar ask`) instead
# of the centred menu, which writes the typed text into the selection file
# and then creates the done file (a cancel creates the done file only).
# Whenever no drop-down takes the question (no Tusche Bar, no drop-down, the
# shell not answering), Omarchy's own command runs with the same arguments.

set -euo pipefail

args=("$@")
prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

menu_width=""

while (( $# > 0 )); do
  case "$1" in
    --width)
      shift
      if (( $# == 0 )); then
        echo "omarchy-menu-input: --width requires a value" >&2
        exit 1
      fi
      menu_width="$1"
      ;;
  esac
  shift
done

shim_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

# PATH without this directory (however it is spelled), so the original
# command, and everything it runs, never comes back here.
path_without_shim() {
  local entry real kept="" first=1
  local -a entries=()
  IFS=: read -r -a entries <<<"$PATH" || true
  for entry in ${entries[@]+"${entries[@]}"}; do
    real=$(cd -- "${entry:-.}" 2>/dev/null && pwd -P) || real=""
    [[ -n $real && $real == "$shim_dir" ]] && continue
    if (( first )); then
      kept=$entry
      first=0
    else
      kept+=":$entry"
    fi
  done
  printf '%s' "$kept"
}

original() {
  PATH=$(path_without_shim)
  export PATH
  omarchy-menu-input ${args[@]+"${args[@]}"}
}

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

payload=$(perl -MEncode=decode -MJSON::PP=encode_json -e '
  my $payload = {
    mode => "input",
    prompt => decode("UTF-8", $ARGV[0]),
    selectionFile => decode("UTF-8", $ARGV[1]),
    doneFile => decode("UTF-8", $ARGV[2])
  };
  $payload->{width} = int($ARGV[3]) if length($ARGV[3] // "");
  $payload->{token} = decode("UTF-8", $ARGV[4]) if length($ARGV[4] // "");
  print encode_json($payload)
' "$prompt" "$selection_file" "$done_file" "$menu_width" "${TUSCHE_BAR_ASK_TOKEN:-}")

reply=$(omarchy-shell tusche-bar ask "$payload" 2>/dev/null) || reply=""
if [[ $reply != "ok" ]]; then
  # Our files go first: a drop-down that took the question after all (a late
  # reply) sees its asker gone and drops it.
  rm -f "$selection_file" "$done_file"
  original
  exit
fi

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
